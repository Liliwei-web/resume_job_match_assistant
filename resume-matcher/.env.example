# ---- Database (used by docker compose substitution) ----
POSTGRES_USER=resume
POSTGRES_PASSWORD=resume
POSTGRES_DB=resume_matcher

# ---- Application ----
APP_PORT=8080
JWT_SECRET=please-change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SEED_DEMO_DATA=true

# ---- LLM (DeepSeek, OpenAI-compatible) ----
# Keep the real key ONLY in .env (git-ignored). Never commit it.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
